# Run this worker ONLY where Binance access is permitted (e.g. your home in Thailand).
BINANCE_ENV=testnet            # testnet | live
ALLOW_LIVE=false               # must be true to use BINANCE_ENV=live
DRY_RUN=true                   # keep true until testnet results look right
BINANCE_API_KEY=
BINANCE_API_SECRET=            # key: trade only, NO withdrawal permission, IP-whitelisted
WORKER_TOKEN=                  # random, >= 24 chars (openssl rand -hex 24); same value in dashboard .env
WORKER_HOST=127.0.0.1          # set to this machine's Tailscale IP (100.x.y.z)
WORKER_PORT=4000
SYMBOLS=BTCUSDT,ETHUSDT
MAX_NOTIONAL_USD=50

# ---- Phase 1 multi-bot scanner (paper trading only) ----
# Off unless true.
PHASE1_ENABLED=true
# Optional. Without it the scanner still logs signals but opens NO paper trades (fail closed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Market data source: live = real Binance public data (no key needed), testnet = testnet data.
DATA_SOURCE=live
# Everything below is optional (defaults shown).
# SCAN_INTERVAL_MS=300000
# KLINE_INTERVAL=15m
# VOLUME_FILTER_USD=5000000
# MIN_TECH_SCORE=0.65
# MIN_AI_CONFIDENCE=0.6
# MAX_ORDERS_PER_SYMBOL=3

# ---- Backtest (optional) ----
# Where history and results are stored. Default: the folder of PHASE1_DB.
# QT_DATA_DIR=C:\quantumtrade-data
# Forex/gold cost model per side, in percent (spread + slippage). Defaults shown.
# BT_FOREX_FEE_PCT=0.005
# BT_FOREX_SLIP_PCT=0.005
# Live paper-trading rules added in v3 (defaults shown).
# SLIPPAGE_PCT=0.02
# MAX_OPEN_PER_SIDE=12
# BREAKER_PAUSE_MIN=120

# ---- Account safety for the manual /order endpoint (all optional; unset = not applied) ----
# LEVERAGE=5
# MARGIN_TYPE=ISOLATED
# Refuse new orders when the total open notional would exceed this (USD).
# MAX_TOTAL_NOTIONAL_USD=500
# Refuse new orders after today's (UTC) realized loss + fees + funding reaches this (USD).
# MAX_DAILY_LOSS_USD=50

# ---- Order safety (manual /order endpoint) ----
# Seconds before the same symbol+side may be ordered again (blocks double clicks / retries).
# ORDER_COOLDOWN_SEC=30
# Audit log of every order attempt (default: next to PHASE1_DB).
# ORDER_AUDIT_FILE=C:\quantumtrade-data\orders-audit.jsonl
