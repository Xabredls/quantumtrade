# Run this worker ONLY where Binance access is permitted (e.g. your home in Thailand).
BINANCE_ENV=testnet            # testnet | live
ALLOW_LIVE=false               # must be true to use BINANCE_ENV=live
DRY_RUN=true                   # keep true until testnet results look right
BINANCE_API_KEY=
BINANCE_API_SECRET=            # key: trade only, NO withdrawal permission, IP-whitelisted
WORKER_TOKEN=                  # random, >= 24 chars (openssl rand -hex 24); same value in dashboard .env
WORKER_HOST=127.0.0.1          # set to this machine's Tailscale IP (100.x.y.z)
WORKER_PORT=4000
SYMBOLS=BTCUSDT,ETHUSDT
MAX_NOTIONAL_USD=50

# ---- Phase 1 multi-bot scanner (paper trading only) ----
# Off unless true.
PHASE1_ENABLED=true
# Optional. Without it the scanner still logs signals but opens NO paper trades (fail closed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Market data source: live = real Binance public data (no key needed), testnet = testnet data.
DATA_SOURCE=live
# Everything below is optional (defaults shown).
# SCAN_INTERVAL_MS=300000
# KLINE_INTERVAL=15m
# VOLUME_FILTER_USD=5000000
# MIN_TECH_SCORE=0.65
# MIN_AI_CONFIDENCE=0.6
# MAX_ORDERS_PER_SYMBOL=3
