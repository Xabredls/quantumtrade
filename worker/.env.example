# Run this worker ONLY where Binance access is permitted (e.g. your home in Thailand).
BINANCE_ENV=testnet            # testnet | live
ALLOW_LIVE=false               # must be true to use BINANCE_ENV=live
DRY_RUN=true                   # keep true until testnet results look right
BINANCE_API_KEY=
BINANCE_API_SECRET=            # key: trade only, NO withdrawal permission, IP-whitelisted
WORKER_TOKEN=                  # random, >= 24 chars (openssl rand -hex 24); same value in dashboard .env
WORKER_HOST=127.0.0.1          # set to this machine's Tailscale IP (100.x.y.z)
WORKER_PORT=4000
SYMBOLS=BTCUSDT,ETHUSDT
MAX_NOTIONAL_USD=50
