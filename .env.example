GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash  # verify the model name in the Gemini API docs
HOST=127.0.0.1                 # set to the VM's Tailscale IP
PORT=3000
WORKER_URL=                    # e.g. http://100.x.y.z:4000 (worker's Tailscale IP)
WORKER_TOKEN=                  # same value as worker/.env

# Login for the whole dashboard (HTTP Basic, 8+ characters). Unset = no login. Use it through Tailscale or HTTPS.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=

# The dashboard does not use /api/exchange/order. It is OFF unless you turn it on AND set a key (16+ characters).
# ENABLE_ORDER_PROXY=true
# ORDER_PROXY_KEY=
